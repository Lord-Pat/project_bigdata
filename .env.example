SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Producción: contraseña aleatoria de al menos 16 caracteres.
ADMIN_PASSWORD=
# Secreto independiente y aleatorio de al menos 32 caracteres para firmar sesiones.
ADMIN_SESSION_SECRET=
# Opcional: origen exacto, sin barra final (ej. https://meteolab.vercel.app).
# Si se omite se utiliza el origen de la URL de la petición.
APP_ORIGIN=
# Alternativa heredada: SUPABASE_SERVICE_ROLE_KEY=
# También se admite NEXT_PUBLIC_SUPABASE_URL para la URL (no es un secreto).
# Nunca prefijes una clave secreta con NEXT_PUBLIC_.
